# =============================================================================
# SecurWork — Environment Configuration (Django + React)
# Copy to .env and update values. NEVER commit .env to git.
# =============================================================================

# --- Django ---
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_PASSWORD=change-me-strong-password

# --- Database ---
# Local dev (no Docker): USE_SQLITE=true
# Docker / production: USE_SQLITE=false and PostgreSQL settings below
USE_SQLITE=true

# --- PostgreSQL (Docker / production) ---
DB_NAME=securwork
DB_USER=securwork
DB_PASSWORD=change-me-db-password
DB_HOST=db
DB_PORT=5432

# --- Frontend ---
FRONTEND_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Local dev only — production uses same domain for site + API (no extra CSRF origins needed)
CSRF_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Store ---
VAT_RATE=22.00
LOW_STOCK_THRESHOLD=5
SEED_DATA=true

# --- Email (contact form & order notifications) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@securwork.it
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
CONTACT_EMAIL=info@securwork.it
ORDER_ADMIN_EMAIL=info@securwork.it
DEFAULT_FROM_EMAIL=noreply@securwork.it

# --- Company info (contact page, footer, map) ---
SECURWORK_COMPANY_NAME=SecurWork S.r.l.
SECURWORK_COMPANY_VAT=[PLACEHOLDER] P.IVA
SECURWORK_COMPANY_ADDRESS=[PLACEHOLDER] Via Esempio 1
SECURWORK_COMPANY_CITY=[PLACEHOLDER] Milano, Italia
SECURWORK_COMPANY_PHONE=+39 [PLACEHOLDER]
SECURWORK_MAP_LAT=45.4642
SECURWORK_MAP_LNG=9.1900

# Shipping
SHIPPING_FLAT_RATE=5.99
FREE_SHIPPING_THRESHOLD=100.00

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Bank transfer details (shown at checkout)
SECURWORK_BANK_IBAN=IT00X0000000000000000000000
SECURWORK_BANK_BIC=EXAMPLEBIC
SECURWORK_BANK_ACCOUNT_NAME=SecurWork S.r.l.

# --- Production only (Hostinger VPS) ---
# DEBUG=false
# SECURE_SSL_REDIRECT=true
# DOMAIN=www.securwork.it
